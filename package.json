{
	"name": "sv-minecrafty",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#runner/*": "./runner/*",
		"#test/*": "./src/test/*"
	},
	"scripts": {
		"dev": "bun run --bun vite dev",
		"start": "bun build/index.js",
		"db:generate": "drizzle-kit generate",
		"build": "bun run --bun vite build",
		"build:compile": "MINECRAFTY_COMPILE=1 bun run build",
		"preview": "bun run --bun vite preview",
		"prepare": "svelte-kit sync && lefthook install || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint && eslint \"**/*.svelte\"",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "bun run --bun vitest run",
		"test:watch": "bun run --bun vitest"
	},
	"dependencies": {
		"@flexiboards/svelte": "^1.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/urbanist": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.68.0",
		"@shadcn/lint": "^0.2.5",
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tabler/icons-svelte": "^3.50.0",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/svelte-table": "^9.3.1",
		"@tanstack/svelte-virtual": "^3.13.52",
		"@types/bun": "^1.4.4",
		"@types/node": "^24.19.2",
		"@wasm-fmt/taplo_fmt": "^0.2.5",
		"bits-ui": "^2.20.4",
		"cn": "^0.5.2",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-oxlint": "^1.90.0",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"jsonc-parser": "^3.3.1",
		"lefthook": "^2.2.2",
		"marked": "^18.1.3",
		"mode-watcher": "^1.1.0",
		"monaco-editor": "^0.57.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.91.0",
		"prettier": "^3.9.10",
		"runed": "^0.38.0",
		"shadcn-svelte": "^1.8.0",
		"smol-toml": "^1.9.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"valibot": "^1.5.0",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"xml-formatter": "^3.7.0",
		"yaml": "^2.9.1"
	}
}
